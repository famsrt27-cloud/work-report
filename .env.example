# Public values used by the Supabase browser and SSR clients
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values. Never add NEXT_PUBLIC_ to these names.
SUPABASE_SERVICE_ROLE_KEY=replace_me
AUTH_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters
PDF_SARABUN_FONT_PATH=C:\\path\\to\\Sarabun-Regular.ttf

# Optional organisation name shown in the UI and PDFs
NEXT_PUBLIC_ORGANIZATION_NAME=สำนักงานตัวอย่าง

# One-time bootstrap values for `npm run bootstrap:admin` (do not commit real values)
BOOTSTRAP_ADMIN_USERNAME=0000001
BOOTSTRAP_ADMIN_FULL_NAME=ผู้ดูแลระบบ
BOOTSTRAP_ADMIN_POSITION=ผู้ดูแลระบบ
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
# BOOTSTRAP_ADMIN_DEPARTMENT_ID=
